---
// src/components/About.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="about">
    <div class="container">
        <h2>{t('about.heading')}</h2>
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
    </div>
</section>