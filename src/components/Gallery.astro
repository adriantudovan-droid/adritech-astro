---
// No JS needed
---
<section id="gallery" class="gallery">
    <div class="container">
        <h2 class="section-title">Recent Projects</h2>
        <p class="section-subtitle">A look at real installations — boards, lighting, and home automation work across Brussels.</p>

        <div class="gallery-grid">
            <figure class="gallery-item">
                <img src="/images/project-5.jpg"
                     alt="Custom electrical distribution board with full Qbus home automation system"
                     loading="lazy">
                <figcaption>Qbus home automation — custom distribution board</figcaption>
            </figure>

            <figure class="gallery-item">
                <img src="/images/project-6.jpg"
                     alt="Large electrical distribution board with integrated Niko intercom controller"
                     loading="lazy">
                <figcaption>Full-home distribution board with Niko intercom</figcaption>
            </figure>

            <figure class="gallery-item">
                <img src="/images/project-2.jpg"
                     alt="Cleanly labeled residential electrical distribution board"
                     loading="lazy">
                <figcaption>Residential board — fully labeled per circuit</figcaption>
            </figure>

            <figure class="gallery-item">
                <img src="/images/project-3.jpg"
                     alt="Indirect LED strip lighting installed in a modern kitchen ceiling"
                     loading="lazy">
                <figcaption>Indirect LED lighting — kitchen ambience</figcaption>
            </figure>

            <figure class="gallery-item">
                <img src="/images/project-7.jpg"
                     alt="Custom outdoor lighting fixture, Brussels residential installation"
                     loading="lazy">
                <figcaption>Outdoor lighting — residential exterior</figcaption>
            </figure>

            <figure class="gallery-item">
                <img src="/images/project-4.jpg"
                     alt="Electric underfloor heating installation during egaline pour"
                     loading="lazy">
                <figcaption>Electric underfloor heating — egaline pour in progress</figcaption>
            </figure>

            <figure class="gallery-item">
                <img src="/images/project-1.jpg"
                     alt="Attending the Qbus certified installer programming course"
                     loading="lazy">
                <figcaption>Certified Qbus installer training</figcaption>
            </figure>
        </div>
    </div>
</section>