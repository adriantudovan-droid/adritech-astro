---
// src/components/Gallery.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Defining the gallery as data (not 7 hand-written <figure> blocks) means we
// only iterate the layout once. To add/remove a photo: change this list.
const projects = [
    { id: '5', src: '/images/project-5.jpg' },
    { id: '6', src: '/images/project-6.jpg' },
    { id: '2', src: '/images/project-2.jpg' },
    { id: '3', src: '/images/project-3.jpg' },
    { id: '7', src: '/images/project-7.jpg' },
    { id: '4', src: '/images/project-4.jpg' },
    { id: '1', src: '/images/project-1.jpg' },
] as const;
---

<section id="gallery" class="gallery">
    <div class="container">
        <h2 class="section-title">{t('gallery.heading')}</h2>
        <p class="section-subtitle">{t('gallery.subtitle')}</p>

        <div class="gallery-grid">
            {
                projects.map((p) => (
                    <figure class="gallery-item">
                        <img
                            src={p.src}
                            alt={t(`gallery.project${p.id}.alt` as any)}
                            loading="lazy"
                        />
                        <figcaption>{t(`gallery.project${p.id}.caption` as any)}</figcaption>
                    </figure>
                ))
            }
        </div>
    </div>
</section>