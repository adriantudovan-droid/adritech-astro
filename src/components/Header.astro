---
// src/components/Header.astro
//
// Site header with nav and language switcher. Reads strings from ui.ts so
// the same component renders in EN/FR/NL depending on the current page.
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Build the URL for each language version of the *current* page.
// French lives at /, English at /en/, Dutch at /nl/.
function urlForLang(target: string): string {
    if (target === 'fr') return '/';
    return `/${target}/`;
}
---

<header class="site-header">
    <div class="container">
        <a href={urlForLang(lang)} class="logo">AdriTech</a>
        <nav class="main-nav">
            <ul>
                <li><a href="#services">{t('nav.services')}</a></li>
                <li><a href="#about">{t('nav.about')}</a></li>
                <li><a href="#gallery">{t('nav.gallery')}</a></li>
                <li><a href="#testimonials">{t('nav.testimonials')}</a></li>
                <li><a href="#contact">{t('nav.contact')}</a></li>
            </ul>
        </nav>
        <div class="lang-switcher" aria-label={t('nav.language')}>
            {
                Object.keys(languages).map((code) => {
                    const isActive = code === lang;
                    return isActive ? (
                        <a href={urlForLang(code)} class="lang-active" aria-current="true">
                            {code.toUpperCase()}
                        </a>
                    ) : (
                        <a href={urlForLang(code)}>{code.toUpperCase()}</a>
                    );
                })
            }
        </div>
        <button class="nav-toggle" aria-label={t('nav.openMenu')}>☰</button>
    </div>
</header>